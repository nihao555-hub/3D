# ===== Supabase 本地栈（npx supabase status -o env 查看实际值）=====
VITE_SUPABASE_URL='http://127.0.0.1:54321'
VITE_SUPABASE_ANON_KEY="<ANON_KEY>"
SUPABASE_SERVICE_ROLE_KEY="<SERVICE_ROLE_KEY>"

# ===== 运行环境：local 自动跳过计费 =====
ENVIRONMENT="local"

# ===== AI 模型接入（三种通道至少配一个）=====
# 通道A：OpenAI 兼容中转/网关（推荐，走 Responses API，自动去除模型名厂商前缀）
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL=""            # 例如 https://your-relay.com/v1
# 通道B：Anthropic 协议（直连或兼容中转）
ANTHROPIC_API_KEY=""
# ANTHROPIC_BASE_URL=""
# 通道C：Gemini 协议（直连或兼容中转）
GOOGLE_API_KEY=""
# GOOGLE_BASE_URL=""

# ===== 界面模型配置 =====
# 白名单（逗号分隔，只展示上游真正支持函数调用的模型）
VITE_ENABLED_MODELS="openai/gpt-5.6-sol"
# 新会话默认模型
VITE_DEFAULT_MODEL="openai/gpt-5.6-sol"

# ===== 可选：AI 网格工作流 =====
# 方式A：腾讯云 TokenHub 混元生3D（推荐国内使用；文生3D直出，免隧道免webhook）
# Key 创建：https://console.cloud.tencent.com/tokenhub → API Key 管理（广州区）
TENCENT3D_API_KEY=""
# TENCENT3D_BASE_URL="https://tokenhub.tencentmaas.com"
# 方式B：fal.ai（多模型市场：Tripo/Meshy/混元mini；需公网回调隧道）
FAL_KEY=""                        # https://fal.ai/dashboard/keys
OPENAI_API_KEY=""                 # 图像生成优先走 OpenAI，未配置自动回退 FLUX

# ===== 回调地址（仅网格工作流需要公网可达；本地开发用隧道）=====
ADAM_URL="http://localhost:3000"
WEBHOOK_BASE_URL="http://localhost:3000"
# NGROK_URL=""                    # 指向 Supabase(54321) 的公网隧道
